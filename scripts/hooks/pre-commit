#!/bin/sh
# Fast checks before each commit (install with `just install-hooks`).
# Skip once with `git commit --no-verify`.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Never commit a secret. Looks only at added lines of staged files.
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+' | grep -vE '^\+\+\+' |
  grep -qE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,}|glpat-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|sk_live_[A-Za-z0-9]{20,}'; then
  echo "pre-commit: the staged changes contain what looks like a private key or token." >&2
  echo "Remove it (and rotate it if it is real). Test fixtures: build the value at runtime instead." >&2
  exit 1
fi

# 2. Rust formatting, when Rust changed.
if echo "$staged" | grep -qE '\.rs$'; then
  cargo fmt --all -- --check || { echo "pre-commit: run 'cargo fmt --all'." >&2; exit 1; }
fi

# 3. UI typecheck and unit tests, when the UI changed.
if echo "$staged" | grep -qE '^apps/desktop/(src|test)/|^apps/desktop/package.json'; then
  pnpm --filter @setu/desktop typecheck
  pnpm --filter @setu/desktop test
fi
